# ==========================================
# University Student Support Chatbot - Environment Config
# ==========================================

# Application
PROJECT_NAME="University Student Support AI Chatbot"
VERSION="1.0.0"

# Security (Change in production!)
SECRET_KEY="super-secret-university-chatbot-jwt-key-change-in-prod-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite for zero-config local run, or PostgreSQL URI for production)
# Example PostgreSQL: postgresql://username:password@localhost:5432/university_chatbot
DATABASE_URL="sqlite:///./university_chatbot.db"

# AI / Google Gemini LLM Integration (Optional)
# If provided, powers response generation via Gemini 3.8 Flash.
# If omitted, system seamlessly runs using the built-in intelligent RAG semantic synthesizer!
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# RAG & Similarity Configuration
SIMILARITY_THRESHOLD=0.25
MAX_RETRIEVED_CHUNKS=4

# Uploads
UPLOAD_DIR="uploads"
